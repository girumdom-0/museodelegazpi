<krpano version="1.24" title="Virtual Tour">

    <!-- 1. GLOBAL INCLUDES -->
    <!-- Imports the default tour skin (controls bar, default hotspot styles, thumbnail list) -->
    <include url="skin/vtourskin.xml" />


    <!-- 2. OVERLAY LAYERS (UI & POPUPS) -->

    <!-- Intro Instructions Screen Overlay -->
    <layer name="intro"
           type="container"
           keep="true"
           width="100%"
           height="100%"
           bgcolor="0x000000"
           bgalpha="0.2"
           zorder="9999"
           enabled="true"
           bgcapture="true"
           onclick="on_intro_click();">

        <!-- Image graphic inside the intro layer detailing navigation instructions -->
         <layer name="intro_guide"
             enabled="true"
             visible="true"
             url="skin/intro.png"
             align="center"
             width="90%"
             height="prop"
             scale="0.6"
             width.mobile="calc:stagewidth*0.82"
             height.mobile="calc:stageheight*0.78"
             scale.mobile="1.0"
             keep="true"
             onresize.mobile="set(layer[intro_guide].width, calc:stagewidth*0.82); set(layer[intro_guide].height, calc:stageheight*0.78);" />
    </layer>

    <!-- Watermark / Branding Logo fixed at top-left corner -->
    <layer name ="logo"
           url="skin/logo.png"
           align="topleft"
           scale="0.5"
           keep="true">
    </layer>

    <!-- Fades out and hides the intro layer on first user click -->
    <action name="on_intro_click">
        tween(layer[intro].alpha, 0, 0.5, easeOutQuad, set(layer[intro].visible, false));
    </action>


    <!-- 2A. IMAGE POPUP LAYERS (Legacy / Fallback Overlays) -->

    <!-- Basic Image Popup Background Container -->
    <layer name="img_popup_bg_fallback"
           type="container"
           keep="true"
           width="100%"
           height="100%"
           bgcolor="0x000000"
           bgalpha="0.7"
           zorder="9999"
           visible="false"
           alpha="0.0"
           bgcapture="true"
           onclick="hide_image_popup();">

        <!-- Displayed Photo Element inside the modal -->
        <layer name="img_popup_photo_fallback"
               url=""
               align="center"
               width="prop"
               height="80%"
               enabled="false" />

        <!-- Bottom Text Hint -->
        <layer name="img_popup_close_text_fallback"
               type="text"
               html="[ Click anywhere to close ]"
               align="bottom"
               y="30"
               css="color:#FFFFFF; font-size:14px; font-family:Arial;"
               bg="false"
               enabled="false" />
    </layer>

    <!-- Advanced Interactive Image Popup Overlay (Draggable & Zoomable) -->
    <layer name="img_popup_bg"
           type="container"
           keep="true"
           width="100%"
           height="100%"
           bgcolor="0x000000"
           bgalpha="0.8"
           zorder="9999"
           visible="false"
           alpha="0.0"
           bgcapture="true">

        <!-- Draggable Photo Element -->
        <layer name="img_popup_photo"
               url=""
               align="center"
               x="0" y="0"
               width="prop"
               height="75%"
               scale="1.0"
               enabled="true"
               ondown="draglayer();" />

        <!-- Zoom-In Button (+): Increases photo scale by 20% -->
        <layer name="img_popup_zoomin"
               type="text"
               html="+"
               align="right" x="30" y="-30"
               css="color:#FFFFFF; font-size:24px; font-weight:bold; text-align:center; background-color:rgba(255,255,255,0.2); width:40px; height:40px; line-height:38px; border-radius:20px; cursor:pointer;"
               bg="false"
               onclick="mul(layer[img_popup_photo].scale, 1.2); set(layer[img_popup_photo].x, layer[img_popup_photo].x);" />

        <!-- Zoom-Out Button (-): Decreases photo scale by 20% -->
        <layer name="img_popup_zoomout"
               type="text"
               html="&amp;minus;"
               align="right" x="30" y="30"
               css="color:#FFFFFF; font-size:24px; font-weight:bold; text-align:center; background-color:rgba(255,255,255,0.2); width:40px; height:40px; line-height:38px; border-radius:20px; cursor:pointer;"
               bg="false"
               onclick="div(layer[img_popup_photo].scale, 1.2); set(layer[img_popup_photo].x, layer[img_popup_photo].x);" />

        <!-- Close Button (Top-Right) -->
        <layer name="img_popup_close"
               type="text"
               html="✕ Close"
               align="topright" x="20" y="20"
               css="color:#FFFFFF; font-size:14px; background-color:rgba(0,0,0,0.5); padding:6px 12px; border-radius:4px; cursor:pointer;"
               bg="false"
               onclick="hide_image_popup();" />

        <!-- Footer Instructions Hint -->
        <layer name="img_popup_close_text"
               type="text"
               html="[ Drag to move • Click outside or hit Close to exit ]"
               align="bottom" y="20"
               css="color:#CCCCCC; font-size:13px; font-family:Arial;"
               bg="false"
               onclick="hide_image_popup();" />
    </layer>


    <!-- 2B. IMAGE POPUP ACTIONS -->

    <!-- Opens image modal, resets position/scale, and fades in -->
    <action name="show_image_popup">
        js(showImagePopup(%1));
    </action>

    <!-- Smoothly fades out and hides image modal -->
    <action name="hide_image_popup">
        js(hideImagePopup());
    </action>

    <!-- Asynchronous loop handling dynamic mouse-dragging for layers -->
    <action name="draglayer">
        copy(drag_x, mouse.stagex);
        copy(drag_y, mouse.stagey);
        copy(drag_layerx, layer[img_popup_photo].x);
        copy(drag_layery, layer[img_popup_photo].y);
        asyncloop(pressed,
            sub(dx, mouse.stagex, drag_x);
            sub(dy, mouse.stagey, drag_y);
            set(layer[img_popup_photo].x, add(drag_layerx, dx));
            set(layer[img_popup_photo].y, add(drag_layery, dy));
        );
    </action>


    <!-- 2C. 3D MODEL OVERLAY CONTAINER & ACTIONS -->

    <!-- Fullscreen dimming backdrop layer for 3D views -->
    <layer name="model3d_container"
           type="container"
           keep="true"
           width="100%"
           height="100%"
           bgcolor="0x000000"
           bgalpha="0.85"
           zorder="9999"
           visible="false"
           alpha="0.0"
           bgcapture="true">

        <layer name="model3d_close"
               type="text"
               html="✕ Close 3D View"
               align="topright" x="20" y="20"
               css="color:#FFFFFF; font-size:14px; background-color:rgba(0,0,0,0.6); padding:8px 16px; border-radius:4px; cursor:pointer;"
               bg="false"
               onclick="hide_3d_obj();" />

        <layer name="model3d_hint"
               type="text"
               html="[ Left Click + Drag to Rotate • Scroll to Zoom ]"
               align="bottom" y="20"
               css="color:#CCCCCC; font-size:13px; font-family:Arial;"
               bg="false"
               enabled="false" />
    </layer>

    <!-- Displays 3D modal and communicates with Three.js via JS interface -->
    <action name="show_3d_obj">
        js(loadGLBModel(%1, %2));
    </action>

    <!-- Closes 3D modal and disposes active 3D geometries in JavaScript -->
    <action name="hide_3d_obj">
        js(clearGLBModel());
    </action>


